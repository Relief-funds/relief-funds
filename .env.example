# ─────────────────────────────────────────────────────────────────────────────
# Relief Funds — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root, created automatically by Prisma)
DATABASE_URL="file:./dev.db"

# ── Stellar network ───────────────────────────────────────────────────────────
# "testnet" or "mainnet"
STELLAR_NETWORK="testnet"

# Soroban RPC endpoint
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Network passphrase (filled automatically from STELLAR_NETWORK, but can override)
# Testnet:  Test SDF Network ; September 2015
# Mainnet:  Public Global Stellar Network ; September 2015
# STELLAR_NETWORK_PASSPHRASE=

# ── Contract ──────────────────────────────────────────────────────────────────
# Deployed ReliefFund Soroban contract address (C… address after deployment)
RELIEF_FUND_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"

# ── Admin keypair ─────────────────────────────────────────────────────────────
# Stellar secret key (S…) of the account that was set as contract admin.
# This account signs all on-chain transactions (create_program, disburse, etc.)
# Generate a fresh keypair: https://laboratory.stellar.org/#account-creator
ADMIN_SECRET_KEY="SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── Token (asset) ─────────────────────────────────────────────────────────────
# Stellar Asset Contract (SAC) address for the disbursement token.
# USDC on testnet: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# XLM native SAC:  CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
DEFAULT_TOKEN_ADDRESS="CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA"

# ── Next.js ───────────────────────────────────────────────────────────────────
# Public base URL used for internal fetch() calls in server components (if any)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
